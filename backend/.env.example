# ==============================================================================
# CredNexa Backend Safe Environment Example (.env.example)
# ==============================================================================
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# Backend Server & API Settings
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info
SECRET_KEY=change_this_to_a_secure_random_string_in_production
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Groq LLM API Configuration (PROJECT_FEATURES_AND_GROQ.md)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=700
GROQ_TIMEOUT_SECONDS=10.0

# Supabase PostgreSQL Database & Auth Settings
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# Machine Learning Model Artifact Paths
MODEL_PATH=../artifacts/model_v1.joblib
CLUSTER_PATH=../artifacts/cluster_v1.joblib
METRICS_PATH=../artifacts/metrics.json
DATA_PATH=../data/Loan_Data.csv
RANDOM_SEED=42
